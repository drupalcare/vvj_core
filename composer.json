{
    "name": "drupal/vvj_core",
    "description": "Foundation module for the VVJ Views renderer family \u2014 abstract Style plugin base, shared services, custom-element JS base, cascade-layer CSS contract. Required by every drupal/vvjX module.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Alaa Haddad (alaahaddad.com)",
            "homepage": "https://www.drupal.org/u/flashwebcenter",
            "role": "Maintainer"
        }
    ],
    "homepage": "https://drupal.org/project/vvj_core",
    "require": {
        "php": ">=8.3",
        "drupal/core": "^11.3 || ^12"
    },
    "require-dev": {
        "drupal/ai": "^1.2",
        "drupal/key": "^1.18"
    },
    "support": {
        "issues": "https://drupal.org/project/issues/vvj_core",
        "source": "https://git.drupalcode.org/project/vvj_core"
    },
    "suggest": {
        "drupal/ai": "^1.2 \u2014 required by the vvj_core_ai sub-module, which is optional. vvj_core itself does not need it."
    },
    "scripts": {
        "phpcs": "phpcs --standard=phpcs.xml.dist",
        "phpcbf": "phpcbf --standard=phpcs.xml.dist",
        "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=512M",
        "lint": [
            "@phpcs",
            "@phpstan"
        ]
    }
}
